import board
import digitalio
import time

# Rows: driven LOW one at a time (outputs) -- correct for COL2ROW
row_pins = [board.D0, board.D1, board.D2]
rows = []
for pin in row_pins:
    r = digitalio.DigitalInOut(pin)
    r.direction = digitalio.Direction.OUTPUT
    r.value = True  # idle HIGH
    rows.append(r)

# Columns: inputs with pull-up -- correct for COL2ROW
col_pins = [board.D3, board.D7, board.D8]
cols = []
for pin in col_pins:
    c = digitalio.DigitalInOut(pin)
    c.direction = digitalio.Direction.INPUT
    c.pull = digitalio.Pull.UP
    cols.append(c)

print("Manual matrix scan started. Press keys one at a time.")
print("Format: Row n -> Col0 Col1 Col2")

while True:
    for ri, r in enumerate(rows):
        # set this row LOW, others HIGH
        for other in rows:
            other.value = True
        r.value = False
        time.sleep(0.001)  # let it settle

        states = [c.value for c in cols]  # True = not pressed, False = pressed
        if not all(states):
            print("Row", ri, "->", ["PRESSED" if not s else "-" for s in states])

    time.sleep(0.05)
